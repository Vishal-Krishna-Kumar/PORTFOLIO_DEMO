# Google Gemini API key (chat window)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port for local development (optional, defaults to 3000)
PORT=3000

# Spotify (optional). With all three set, the music window shows your real listening
# activity. Without them it shows the curated static list. See "Live Spotify" in the README.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Only needed once, while you obtain the refresh token through /api/login:
SPOTIFY_REDIRECT_URI=https://www.vishal-krishna.me/api/callback
